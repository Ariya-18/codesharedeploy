# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/codeshare

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Client
CLIENT_URL=http://localhost:5173

# Judge0 API (optional - defaults to https://ce.judge0.com without key)
JUDGE0_API_URL=https://ce.judge0.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Code Execution
# ENABLE_LOCAL_RUNNER: Run untrusted code locally (set to false on production)
ENABLE_LOCAL_RUNNER=true

# Email Notifications (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=CodeShare <your_email@gmail.com>

# Features
REQUIRE_EMAIL_VERIFICATION=false

# Optional: LLM for Complexity Analysis
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
